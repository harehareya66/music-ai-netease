{
  "name": "ncm-plugin",
  "version": "0.2.0",
  "description": "DSH 的网易云音乐插件：播放器 + AI DJ，外加场景歌单、口味画像、听歌周报、歌词二创。基座 fork 自 @doitian/dsh-music@1.2.0（MIT）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "music",
    "netease",
    "music.163.com",
    "player",
    "dj"
  ],
  "license": "MIT",
  "author": "doitian (upstream), local fork",
  "homepage": "https://github.com/doitian/dsh-music#readme",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"test/*.test.mjs\"",
    "probe": "node scripts/probe.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
